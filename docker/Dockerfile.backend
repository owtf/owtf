FROM golang:1.24-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN GOMAXPROCS=2 go build -trimpath -ldflags="-s -w" -o /out/owtf-next ./cmd/owtf-next

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 owtf \
    && mkdir -p /data /app/plugins \
    && chown -R owtf:owtf /data /app

COPY --from=build /out/owtf-next /usr/local/bin/owtf-next
COPY --chown=owtf:owtf plugins-next/ /app/plugins/

USER owtf
WORKDIR /app

ENV OWTF_ADDR=:8009 \
    OWTF_DATA_DIR=/data \
    OWTF_PLUGIN_DIR=/app/plugins \
    OWTF_WORKERS=1

EXPOSE 8009
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
    CMD curl --fail --silent http://127.0.0.1:8009/api/v2/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/owtf-next"]
CMD ["serve"]
