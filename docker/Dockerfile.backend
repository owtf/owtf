FROM node:22-bookworm-slim AS ui
WORKDIR /src/web
COPY web/package*.json ./
RUN npm ci
COPY web ./
RUN npm run build

FROM golang:1.24-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY --from=ui /src/internal/api/ui ./internal/api/ui
RUN GOMAXPROCS=2 go build -trimpath -ldflags="-s -w" -o /out/owtf ./cmd/owtf

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 owtf \
    && mkdir -p /data /app/plugins /app/profiles /app/wordlists \
    && chown -R owtf:owtf /data /app

COPY --from=build /out/owtf /usr/local/bin/owtf
COPY --chown=owtf:owtf plugins/ /app/plugins/
COPY --chown=owtf:owtf profiles/ /app/profiles/
COPY --chown=owtf:owtf wordlists/ /app/wordlists/

USER owtf
WORKDIR /app

ENV OWTF_ADDR=:8009 \
    OWTF_DATA_DIR=/data \
    OWTF_PLUGIN_DIR=/app/plugins \
    OWTF_PROFILE_DIR=/app/profiles \
    OWTF_WORDLIST_DIR=/app/wordlists \
    OWTF_WORKERS=1

EXPOSE 8009
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
    CMD curl --fail --silent http://127.0.0.1:8009/api/v2/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/owtf"]
CMD ["serve"]
